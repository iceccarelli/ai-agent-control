+    def test_the_rules_are_read_once_not_every_tick(self):
+        v = Venue()
+        e = engine(v)
+        for k in range(3, 9):
+            e.on_candle(mark=MARK, funding_bps=3.0, spot=MARK,
+                        funding_print_ms=k * H8)
+        assert v.lot_calls == 1
