From 694dc811d8e2a88b2e187e4462927a836f54bbde Mon Sep 17 00:00:00 2001
From: Vincenzo Grimaldi <vince.ceccarelli@gmail.com>
Date: Fri, 11 Sep 2026 17:56:23 +0000
Subject: [PATCH] 0029 zero variance is refused on every interpreter (5372
 passed)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The suite had one failure on python:3.11 — the Dockerfile's interpreter —
that did not reproduce on 3.12:

  test_multiple_testing::test_zero_variance_is_refused_not_infinite

`sum()` is plain float addition on 3.11 and compensated summation on 3.12+.
The mean of [0.1]*30 is 0.10000000000000005 on 3.11, the "variance" of a
constant series is 5e-32 instead of 0.0, and the refusal never fired. A
refusal that depends on the interpreter fired on the developer's box and not
in the image that would run it.

Fix: decide on the VALUES (max == min), not on the arithmetic.

Test first: six constant series, parametrised. Four of the six failed on
3.11 before the fix. All pass on 3.11 and 3.12 after it. No existing test
was changed.

Files: bot/tools/deflated_sharpe.py, bot/tests/test_multiple_testing.py

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01MVNUn9gHXLEqzyyoU2LjND
---
 bot/tests/test_multiple_testing.py | 15 +++++++++++++++
 bot/tools/deflated_sharpe.py       |  7 +++++++
 2 files changed, 22 insertions(+)

diff --git a/bot/tests/test_multiple_testing.py b/bot/tests/test_multiple_testing.py
index 613cfe6..28ecf0b 100644
--- a/bot/tests/test_multiple_testing.py
+++ b/bot/tests/test_multiple_testing.py
@@ -140,6 +140,21 @@ class TestDeflatedSharpe:
         with pytest.raises(ValueError):
             ds.deflated_sharpe_ratio([0.1] * 30, n_trials=5)
 
+    @pytest.mark.parametrize("value,n", [(0.1, 30), (1 / 3, 7), (0.7, 11),
+                                         (1e-9, 100), (-0.3, 13), (2.675, 5)])
+    def test_a_constant_series_is_refused_on_every_interpreter(self, value, n):
+        """The Dockerfile runs python:3.11. `sum()` there is plain left-to-right
+        float addition; 3.12 switched to compensated summation. So the mean of
+        [0.1]*30 is 0.10000000000000005 on 3.11 and exactly 0.1 on 3.12, the
+        "variance" of a constant series is 5e-32 on one and 0.0 on the other,
+        and the zero-variance refusal fired on the developer's box but not in
+        the image that would run it. A refusal that depends on the interpreter
+        is not a refusal."""
+        with pytest.raises(ValueError):
+            ds.sharpe_from_returns([value] * n)
+        with pytest.raises(ValueError):
+            ds.deflated_sharpe_ratio([value] * n, n_trials=5)
+
 
 class TestMinimumTrackRecord:
     def test_weaker_sharpe_needs_a_longer_record(self):
diff --git a/bot/tools/deflated_sharpe.py b/bot/tools/deflated_sharpe.py
index fd2a701..439b870 100644
--- a/bot/tools/deflated_sharpe.py
+++ b/bot/tools/deflated_sharpe.py
@@ -161,6 +161,13 @@ def sharpe_from_returns(returns: Sequence[float]) -> float:
     n = len(returns)
     if n < 2:
         raise ValueError("need at least 2 observations")
+    # Decided on the VALUES, not on the arithmetic. `sum()` is plain float
+    # addition on python 3.11 (the Dockerfile's interpreter) and compensated
+    # summation on 3.12+, so a constant series has a variance of ~5e-32 on one
+    # and exactly 0.0 on the other. A refusal that depends on the interpreter
+    # fired on the developer's box and not in the image.
+    if max(returns) == min(returns):
+        raise ValueError("zero variance: Sharpe undefined")
     mean = sum(returns) / n
     var = sum((r - mean) ** 2 for r in returns) / (n - 1)
     if var <= 0:
