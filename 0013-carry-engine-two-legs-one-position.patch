+class TestFundingDrivesEntryAndExit:
+    def test_thin_funding_stands_aside(self):
+        broker = FakeBroker()
+        eng = engine(broker)
+        decision = eng.on_candle(mark=100_000.0, funding_bps=0.05)
+        assert decision.acted is False
