# syntax=docker/dockerfile:1
# The carry-research WORKER image: PUBLIC-DATA RESEARCH ONLY (its own Fly app, fly.research.toml). It has no exchange credential, no order path and no network client: the worker core is the
# Python standard library (tools/research_service.py + research_jobs + dataset_inventory + agent_contracts), so there is nothing to pip-install. It reads data directories the collector
# wrote and writes typed, quarantined proposals and a status file on its own volume. The modules are named one by one (never `COPY tools/`); tests/test_research_image.py recomputes the
# import closure and fails if a module is missing, if a credential name or a venue module appears, or if the image could place an order.
FROM python:3.15-slim AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY tools/agent_contracts.py tools/dataset_inventory.py tools/research_jobs.py tools/research_service.py ./tools/
COPY deploy/research-entrypoint.sh /usr/local/bin/research-entrypoint
RUN useradd --create-home --shell /usr/sbin/nologin bot \
    && mkdir -p /data && chown -R bot:bot /app /data
ENV HOME=/data
# Starts as root only to chown the volume; the entrypoint drops to `bot` and execs, so Fly's SIGTERM reaches the worker itself.
ENTRYPOINT ["/usr/local/bin/research-entrypoint"]
CMD ["python3", "tools/research_service.py", "run", "--state-dir", "/data/research", "--root", "datasets=/data/datasets", "--root", "backups=/data/backups"]
