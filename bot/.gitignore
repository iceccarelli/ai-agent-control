__pycache__/
*.pyc
.pytest_cache/
.env
state/
*.db
*.db-wal
*.db-shm

# Trained model artefacts. The estimators are large binaries and are
# reproducible from tools/train_policy.py plus the corpus; the MANIFESTs are
# small, human-readable, and are the record of what was trained and whether it
# was promoted — so those are kept.
#
# Three lines, not one: ignoring `models/` alone would stop git descending into
# the directory at all, and the negation below would never match.
models/**
!models/**/
!models/**/MANIFEST.json

# Control-plane tick output. Regenerated from evidence that IS tracked, so
# committing it adds a diff that says only "the clock moved".
#
# NEXT_MISSION.md in particular is a derived instruction file, not a record: a
# committed copy is a copy someone will read after it has gone stale.
artifacts/NEXT_MISSION.md
artifacts/control_plane_tick.json
artifacts/control_plane_loop.log
