{
  "name": "ai-agent-control (paper/testnet only)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "64gb"
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq g++ make && make setup",
  "postStartCommand": "make ops-resume",
  "forwardPorts": [
    8787
  ],
  "portsAttributes": {
    "8787": {
      "label": "control centre (read-only)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "PAPER_TRADING": "1",
    "USE_TESTNET": "1"
  },
  "secrets": {
    "BYBIT_TESTNET_API_KEY": {
      "description": "Bybit TESTNET key: Contract Orders&Positions + Spot Trade only, NO withdrawal/transfer. Testnet only."
    },
    "BYBIT_TESTNET_API_SECRET": {
      "description": "Secret for the Testnet key above."
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "iceccarelli/ai-agent-control": {
          "permissions": {
            "contents": "write",
            "pull_requests": "write",
            "workflows": "write",
            "actions": "write"
          }
        }
      }
    }
  }
}
