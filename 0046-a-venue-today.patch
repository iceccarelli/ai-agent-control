+    precisely how a testnet key reaches mainnet.
+    """
+    raw = env.get("BYBIT_VENUE")
+    stated = env.get("USE_TESTNET")
+    if raw is None or str(raw).strip() == "":
+        sandbox = parse_bool(stated, True)
+        return ("testnet" if sandbox else "mainnet"), sandbox
